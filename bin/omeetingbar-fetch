#!/usr/bin/python3
"""Event source for OMeetingBar, an omarchy shell plugin.

Reads the user's calendar and writes the event cache the QML side polls:
`$XDG_RUNTIME_DIR/omeetingbar/events.json`, mode 0600, replaced atomically.

Three backends:

  eds   default. GNOME Online Accounts + Evolution Data Server, i.e. no OAuth of
        our own: GOA already holds an approved Google login for this machine and
        EDS already syncs the events, so this only reads what is there.
  ics   documented backstop. Google regenerates the private ICS feed only about
        once a day, so it can miss a meeting that was moved this morning. Never
        make this the default.
  demo  synthetic events, standard library only, so the whole alert path can be
        tested before a Google account exists.

`--in-seconds N` additionally arms a test event in a second file next to the
cache, `inject.json` (same 0600/atomic treatment): the QML service re-runs this
script with NO arguments every fetch_interval_seconds, so an event that lived
only in one run's output was overwritten within a minute and the alert could
never fire. Every later run merges the marker back in until it ages out.

Always run with /usr/bin/python3, never a bare `python3`: mise/pyenv shims do not
carry the `gi` bindings the eds backend needs.

Privacy: the cache carries id/title/start/end/all_day/declined/url/calendar/
location, the calendar's EDS source uid (or a key derived from an ICS feed's
URL, never the URL) and, on all-day entries, their dates -- and nothing else:
no attendees, no description, no organizer. Nothing
but counts and error text reaches stdout or the journal, and ICS feed URLs are
treated as secrets (they are bearer tokens: never logged, never quoted in an
error).
"""
import argparse
import configparser
import datetime
import hashlib
import json
import os
import re
import sys
import tempfile
import threading
import time
import urllib.error
import urllib.request

# 2: the cache is the whole two-day agenda, not a list of alert candidates --
# finished occurrences stay in it and a declined one is flagged instead of
# dropped (invariant 5). No consumer validates the number, so it is free
# documentation of which shape a cache file has.
SCHEMA_VERSION = 2
BACKENDS = ("eds", "ics", "demo")

DEFAULT_CONFIG_PATH = os.path.expanduser("~/.config/omarchy/omeetingbar.json")
CACHE_BASENAME = "events.json"
GOA_ACCOUNTS_PATH = os.path.expanduser("~/.config/goa-1.0/accounts.conf")

# Only the keys this script actually needs; the QML reads the rest of the same
# file itself. Types here double as the validator in load_config().
DEFAULTS = {
    "backend": "eds",
    "ics_urls": [],
    # Seven days: the bar promises to ALWAYS name the next meeting, and on a
    # Friday evening that is Monday morning — a 12 h horizon left it blank.
    "lookahead_minutes": 10080,
    "refresh_seconds": 300,
    "alert_lead_seconds": 60,
    "grace_seconds": 300,
    "skip_all_day": True,
    "skip_declined": True,
    "min_duration_minutes": 0,
    "title_blocklist": [],
    "calendars_exclude": [],
    # "auto" follows the session locale (de* -> German, else English); "de" or
    # "en" pins it. Strings.js applies the same rule on the QML side.
    "language": "auto",
}

# ECal.Client.connect_sync's wait_for_connected_seconds is not an upper bound —
# it is waited out in FULL whenever the backend never reports itself connected,
# which is what Google CalDAV sources do here. Measured on 2026-09-10: 30 s per
# calendar (60 s for two, over the service's 45 s watchdog), while 1 s returns a
# client that reads every instance correctly. Keep this at 1: the cost is paid
# per calendar, and the data comes from EDS's local cache either way.
# 0 is deliberately not used — it is not documented as "no wait" and hung in
# testing.
CONNECT_TIMEOUT_SECONDS = 1
ICS_TIMEOUT_SECONDS = 20
MAX_ICS_BYTES = 8 * 1024 * 1024
MAX_DIAGNOSE_EVENTS = 5
# ECal.Client.generate_instances_sync takes the window at face value, so an
# absurd lookahead_minutes really does ask EDS to expand recurrences into the
# year 1.9 million. 30 days is far past anything the widget or the alert can use.
MAX_LOOKAHEAD_MINUTES = 30 * 24 * 60
# Six hours already covers any suspend or lock worth alerting after.
MAX_GRACE_SECONDS = 6 * 3600

# Calendar data is third-party input. These bound what one hostile invite or a
# runaway recurrence rule (FREQ=SECONDLY expands to ~600 000 instances in a
# week) can make this script and the shell do. Service.qml caps again at 512.
MAX_EVENTS = 512
MAX_INSTANCES_PER_CALENDAR = 2000
MAX_URL_CHARS = 2048
# Total budget for the pushed network refresh across all calendars, and for
# all ICS downloads: the service kills the fetcher at 45 s, and a killed run
# writes no cache at all, so every blocking call needs a deadline well inside.
# The refresh budget is charged only for the time spent inside refresh_sync.
# The cutoff bounds the refreshes, not the loop: no refresh starts later than
# this into the calendar loop (connects and expansion count towards it), one
# still running then is cancelled, and the calendars after it are still read,
# from the local copy.
REFRESH_BUDGET_SECONDS = 15
REFRESH_CUTOFF_SECONDS = 25
ICS_BUDGET_SECONDS = 30
# A pushed refresh that has not succeeded for this long means EDS is serving
# its old local copy (revoked token, VPN down) and the user has to be told.
# A refresh_seconds above it raises the threshold to match.
REFRESH_STALE_SECONDS = 1800
# refresh_sync reports success whatever the server answered; EDS tells the
# outcome as D-Bus signals instead -- the source asking for credentials, its
# connection status. The refresh call returns once the backend has its answer,
# so the signals are queued by then, but the fetcher runs no main loop: after
# the calendar loop it lets them in for this long (measured on EDS 3.60).
SYNC_SETTLE_SECONDS = 0.3

# Exactly the packages README.md and install.sh name, in the same order, so
# the sentence the user reads here is the command they can paste.
# gnome-online-accounts-gtk is the GOA dialog on this machine and a separate
# package from the gnome-online-accounts library, so it has to be listed.
# python-gobject is in Omarchy's base set, but nothing in the other three
# depends on it and the eds backend cannot start without it.
EDS_PACKAGES = ("sudo pacman -S --needed gnome-online-accounts "
                "gnome-online-accounts-gtk evolution-data-server python-gobject")
GOA_DIALOG = "gnome-online-accounts-gtk"
ICS_PACKAGES = "sudo pacman -S python-icalendar python-recurring-ical-events"

