def pick_language(override, environ):
    """"de" or "en". `override` is omeetingbar.json's `language`; anything but
    "de"/"en" ("auto", a missing key) defers to the first locale variable set."""
    wanted = str(override or "").strip().lower()
    if wanted in ("de", "en"):
        return wanted
    for key in ("LC_ALL", "LC_MESSAGES", "LANG"):
        value = environ.get(key) or ""
        if value:
            return "de" if value.lower().startswith("de") else "en"
    return "en"


# From the environment until main() has read the config; load_config's own
# warnings therefore follow the session locale.
LANGUAGE = pick_language("", os.environ)


def _(key, *args):
    text = MESSAGES.get(LANGUAGE, MESSAGES["en"]).get(key)
    if text is None:
        text = MESSAGES["en"].get(key, key)
    return text % args if args else text

# Namespace -> versions to try, most likely first. Arch ships ICalGLib 4.0 ONLY,
# and it comes from libical, not from evolution-data-server:
#   pacman -Fq ICalGLib-4.0.typelib -> extra/libical   (3.0 matches nothing)
#   pacman -Fl libical | grep typelib -> ICal-4.0, ICalGLib-4.0
# so 4.0 is probed first; 3.0 stays only as a fallback for an older libical.
EDS_NAMESPACES = (
    ("EDataServer", ("1.2",)),
    ("ECal", ("2.0",)),
    ("ICalGLib", ("4.0", "3.0")),
)

# Which pacman package actually ships a namespace's typelib, so a missing one is
# blamed on the right package (evolution-data-server depends on libical, so the
# install command stays the same either way).
TYPELIB_PACKAGES = {"ICalGLib": "libical"}
DEFAULT_TYPELIB_PACKAGE = "evolution-data-server"


def typelib_package(namespace):
    return TYPELIB_PACKAGES.get(namespace, DEFAULT_TYPELIB_PACKAGE)


# Hosts, not free-form URLs: the authority must be one of the conferencing
# providers, so a stray link in a description cannot be mistaken for a room.
# Slack and Discord also carry plain links to messages and servers, so for them
# only a huddle, a voice channel or an invite counts. Providers.js maps the same
# hosts to a glyph and a brand colour; keep the two lists in step.
# The host has to END after the allow-listed name (a port may follow): without
# the lookahead, "zoom.us.evil.example" matched as zoom.us. A URL also ends at
# Markdown emphasis, at a backslash (browsers read it as "/") and at the
# zero-width characters that invite bodies pasted from chat tools carry.
_URL_END = r"[^\s<>\"'*|\\​‌‍﻿]"
# Hosts fold case in ASCII only, inside (?a:...) groups. Plain IGNORECASE folds
# by Unicode, where the dotless "ı" and the dotted "İ" equal "i", the long "ſ"
# equals "s" and the Kelvin sign (U+212A) equals "k": so "teams.lıve.com" or
# "zoom.uſ" passed the allow-list while the browser opens another, IDN-encoded
# host. The scheme does not fold at all: clean_url, like every later check,
# takes a lowercase "https://" only, so a "httpſ://" or "HTTPS://" match was a
# decoy that hid the real link after it. The port takes ASCII digits only.
# Not a global re.ASCII: \s in _URL_END would then miss NBSP and U+3000, and a
# link would no longer end there. The lookahead stays Unicode on purpose, so a
# lookalike letter right after the name rejects the host instead of cutting it.
JOIN_URL_RE = re.compile(
    r"(?-i:https://)(?:"
    r"(?a:(?:[A-Za-z0-9-]+\.)*"
    r"(?:meet\.google\.com|zoom\.us|zoomgov\.com|teams\.microsoft\.com|teams\.live\.com"
    r"|webex\.com|meet\.jit\.si|8x8\.vc|whereby\.com"
    r"|gotomeeting\.com|meet\.goto\.com|gotomeet\.me))"
    r"(?::[0-9]{1,5})?(?![A-Za-z0-9.-])"
    r"(?:[/?#]" + _URL_END + r"*)?"
    r"|(?a:app\.slack\.com/huddle/)" + _URL_END + r"+"
    r"|(?a:(?:discord|discordapp)\.com/channels/)" + _URL_END + r"+"
    r"|(?a:discord\.gg/)" + _URL_END + r"+"
    r")",
    re.IGNORECASE,
)
URL_TRAILING_JUNK = ".,;:!?)]}>\"'*_~|​‌‍﻿"
# html.unescape() also decodes legacy entities WITHOUT a semicolon, so a plain
# "?pwd=x&region=eu" in a description came back as "®ion=eu" (same for &para,
# &copy, &sect, &not, &deg). Only the entities an HTML-escaped description can
# actually contain are undone; &amp; last, so "&amp;lt;" ends as the literal
# "&lt;" and not as "<".
_HTML_ENTITIES = (("&lt;", "<"), ("&gt;", ">"), ("&quot;", '"'), ("&#39;", "'"),
                  ("&apos;", "'"), ("&nbsp;", " "), ("&amp;", "&"))


def unescape_html(text):
    for entity, char in _HTML_ENTITIES:
        text = text.replace(entity, char)
    return text


class BackendError(Exception):
    """A backend could not produce a trustworthy event list. Carries a message
    meant for the user's screen, so it must stay free of URLs and tokens."""

    def __init__(self, message):
        super().__init__(message)
        self.message = message


# --- small shared helpers ---------------------------------------------------


def _int(value, default=0):
    return value if isinstance(value, int) and not isinstance(value, bool) else default


def _short(value, limit=140):
    text = " ".join(str(value).split())
    return text if len(text) <= limit else text[: limit - 1] + "…"


def _scrub(value):
    """Error text meant for the user's screen (widget tooltip, `status`): URLs
    -- CalDAV errors quote the request -- and addresses are blanked first."""
    text = re.sub(r"https?://\S+", "<url>", str(value))
    return re.sub(r"\S+@\S+", "<adresse>", text)


def _call(obj, name, default=None):
    """Call a zero-argument getter that may not exist in the installed typelib
    version. Never raises: a missing property is not a reason to lose an event."""
    function = getattr(obj, name, None)
    if function is None:
        return default
    try:
        return function()
    except Exception:
        return default


def _strip_mailto(value):
    value = (value or "").strip()
    return value[7:] if value[:7].lower() == "mailto:" else value


def human_delta(seconds):
    seconds = int(seconds)
    sign = "-" if seconds < 0 else ""
    seconds = abs(seconds)
    if seconds < 60:
        return "%s%d s" % (sign, seconds)
    if seconds < 3600:
        return "%s%d min %d s" % (sign, seconds // 60, seconds % 60)
    if seconds < 86400:
        return "%s%d h %d min" % (sign, seconds // 3600, (seconds % 3600) // 60)
    return "%s%d d %d h" % (sign, seconds // 86400, (seconds % 86400) // 3600)


def runtime_dir():
    base = os.environ.get("XDG_RUNTIME_DIR") or "/run/user/%d" % os.getuid()
    return os.path.join(base, "omeetingbar")


# --- configuration ----------------------------------------------------------


def load_config(path):
    """-> (config, warning). Never raises. A missing file is normal; a broken
    one falls back to the documented defaults and returns a warning that ends
    up in the cache's `warning` field, so the user can actually see it."""
    config = dict(DEFAULTS)
    try:
        with open(path, "r", encoding="utf-8") as handle:
            raw = json.load(handle)
    except FileNotFoundError:
        return config, ""
    except (OSError, ValueError) as exc:
        return config, _("cfgUnreadable", path, _short(exc, 80))
    if not isinstance(raw, dict):
        return config, _("cfgNotObject", path)

    rejected = []
    for key, default in DEFAULTS.items():
        if key not in raw:
            continue
        value = raw[key]
        if isinstance(default, bool):
            valid = isinstance(value, bool)
        elif isinstance(default, int):
            valid = isinstance(value, int) and not isinstance(value, bool) and value >= 0
        elif isinstance(default, list):
            valid = isinstance(value, list) and all(isinstance(item, str) for item in value)
        else:
            valid = isinstance(value, str)
        if valid:
            config[key] = value
        else:
            rejected.append(key)

    if config["backend"] not in BACKENDS:
        rejected.append("backend")
        config["backend"] = DEFAULTS["backend"]

    warnings = []
    if rejected:
        warnings.append(_("cfgInvalid", path, ", ".join(sorted(set(rejected)))))
    if config["lookahead_minutes"] > MAX_LOOKAHEAD_MINUTES:
        warnings.append(_("cfgLookaheadCap", MAX_LOOKAHEAD_MINUTES))
        config["lookahead_minutes"] = MAX_LOOKAHEAD_MINUTES
    if config["grace_seconds"] > MAX_GRACE_SECONDS:
        warnings.append(_("cfgGraceCap", MAX_GRACE_SECONDS))
        config["grace_seconds"] = MAX_GRACE_SECONDS
    return config, " ".join(warnings)


# --- event construction (pure) ----------------------------------------------


def event_id(uid, start_epoch, title=""):
    """sha1(uid + "@" + instance_start)[:16]. Must be byte-identical for the
    same occurrence on every run, otherwise Service.qml re-fires the alert. An
    event without a UID falls back to its title, so two UID-less meetings at the
    same time are not merged into one by the de-duplication."""
    key = "%s@%d" % (uid or ("~" + (title or "")), int(start_epoch))
    return hashlib.sha1(key.encode("utf-8")).hexdigest()[:16]


def make_event(uid, title, start, end, all_day, url, calendar, location, join_path,
               declined=False):
    """One cache entry. `_join_path` records which URL rule matched; every
    underscore key is stripped again before the cache is written -- it exists
    only so --diagnose can name the path without printing the URL.

    `declined` defaults to False because only the eds backend can know it: it
    needs the account's own ATTENDEE line, which neither the ics feed nor the
    demo schedule has, so those two always write False (that is correct, not a
    missing feature)."""
    start = int(start)
    end = int(end) if end is not None else start
    if end < start:
        end = start
    return {
        "id": event_id(uid, start, title),
        "title": _short(title or _("untitled"), 200),
        "start": start,
        "end": end,
        "all_day": bool(all_day),
        "declined": bool(declined),
        # A bound on hostile input, not an argv limit: a notification carries
        # only the event id, never the URL. Service.qml drops over-long URLs too.
        "url": url if url and len(url) <= MAX_URL_CHARS else "",
        "calendar": _short(calendar or "", 120),
        "location": _short(location or "", 200),
        "_join_path": join_path,
    }


def clean_url(value):
    """https-only, no whitespace, no backslash, bounded length, trailing
    sentence punctuation removed -- the same test the QML side applies
    (invariant 3). Descriptions wrap links in prose, so "…/abc-defg-hij." must
    not become part of the room id. The backslash matters because browsers read
    it as "/": "https://evil.example\\@meet.google.com" passes any host check
    that splits on "@" and lands on evil.example."""
    value = (value or "").strip().rstrip(URL_TRAILING_JUNK)
    if len(value) > MAX_URL_CHARS or not re.fullmatch(r"https://[^\s\\]+", value):
        return ""
    return value


def provider_url(value):
    """A CONFERENCE / X-GOOGLE-CONFERENCE value counts only if the whole value is
    a provider URL by the same rule as the regex path. The two properties come
    from the invite like everything else, and an unknown host there would reach
    the browser on Enter while the alert could name no provider."""
    url = clean_url(value)
    return url if url and JOIN_URL_RE.fullmatch(url) else ""


def pick_join_url(conference, x_google_conference, location, description):
    """-> (url, path). Precedence per spec: RFC 7986 CONFERENCE, then
    X-GOOGLE-CONFERENCE, then a provider-host regex over LOCATION, then over
    DESCRIPTION -- every path allow-lists the host. The iCalendar URL property
    is deliberately not consulted: for Google events it is the calendar web
    page, not the meeting room.

    Pure -- no gi, no I/O -- so the precedence can be reasoned about on its own.
    """
    # On Google, X-GOOGLE-CONFERENCE is what carries the Meet link: verified
    # against a real account on 2026-09-10, Google's CalDAV emits it, and it
    # matched on every event in the window.
    for value, path in ((conference, "conference"),
                        (x_google_conference, "x-google-conference")):
        url = provider_url(value)
        if url:
            return url, path
    # The regex is the fallback, for accounts and events without either property.
    # Descriptions arrive HTML-escaped, so &amp; has to be undone before matching
    # or a Zoom link loses its ?pwd= parameter.
    for text, path in ((location, "location-regex"), (description, "description-regex")):
        match = JOIN_URL_RE.search(unescape_html(text or ""))
        if match:
            url = clean_url(match.group(0))
            if url:
                return url, path
    return "", "none"


def apply_filters(events, config, now, window_end):
    """Drop what the user never wants to SEE, de-duplicate by id (the same
    meeting can sit in two subscribed calendars) and sort by start.

    Only the four "I never want this in my agenda" options filter here --
    skip_all_day, calendars_exclude, title_blocklist, min_duration_minutes --
    because since schema 2 the cache is the agenda the popup renders, not a list
    of alert candidates (invariant 5). An occurrence that is already over stays
    in it (the popup lists it, dimmed), and a declined one is flagged by
    make_event instead of dropped. Whether an event may blank the screen is
    Service.qml's single isAlertable() decision, nothing else's.

    `now` is therefore no longer read; it stays in the signature because the
    diagnose path and merge_inject call this with the same four arguments.
    """
    blocked = [term.lower() for term in config["title_blocklist"] if term.strip()]
    excluded = {name.strip().lower() for name in config["calendars_exclude"] if name.strip()}
    min_seconds = config["min_duration_minutes"] * 60

    kept = []
    seen = {}
    for event in events:
        if config["skip_all_day"] and event["all_day"]:
            continue
        if event["calendar"].strip().lower() in excluded:
            continue
        if any(term in event["title"].lower() for term in blocked):
            continue
        if min_seconds and (event["end"] - event["start"]) < min_seconds:
            continue
        # window_end is EXCLUSIVE: it is the local midnight that starts the day
        # after tomorrow, so an event beginning exactly at 00:00 that day belongs
        # to the next agenda, not to this one's "Morgen" section.
        if event["start"] >= window_end:
            continue
        previous = seen.get(event["id"])
        if previous is not None:
            # The same occurrence from two calendars (own + a subscribed team
            # calendar). EDS hands them over sorted by calendar display name, so
            # "first wins" made the declined flag -- and with it whether the
            # fullscreen alert fires -- depend on how the calendars are named.
            # Merge instead: a decline recorded on any copy counts, and the
            # first non-empty join URL is kept.
            if event["declined"] and not previous["declined"]:
                previous["declined"] = True
            if not previous["url"] and event["url"]:
                previous["url"] = event["url"]
            continue
        seen[event["id"]] = event
        kept.append(event)

    kept.sort(key=lambda event: (event["start"], event["id"]))
    return kept


# --- cache I/O --------------------------------------------------------------


def load_cache(path):
    try:
        with open(path, "r", encoding="utf-8") as handle:
            data = json.load(handle)
    except (OSError, ValueError):
        return {}
    return data if isinstance(data, dict) else {}


def previous_events(cache):
    """Last known good list, re-validated field by field: a corrupt cache must
    not be laundered into a fresh cache carrying our name."""
    raw = cache.get("events")
    if not isinstance(raw, list):
        return []
    kept = []
    for item in raw:
        if not isinstance(item, dict):
            continue
        start = _int(item.get("start"), None)
        if start is None or not isinstance(item.get("id"), str):
            continue
        kept.append({
            "id": item["id"],
            "title": str(item.get("title") or ""),
            "start": start,
            "end": _int(item.get("end"), start),
            "all_day": bool(item.get("all_day")),
            # Load-bearing: without this key a backend failure would rebuild a
            # declined meeting as a normal one and blank the screen for a
            # meeting the user has already said no to.
            "declined": item.get("declined") is True,
            "url": str(item.get("url") or ""),
            "calendar": str(item.get("calendar") or ""),
            "location": str(item.get("location") or ""),
        })
    kept.sort(key=lambda event: (event["start"], event["id"]))
    return kept


def stale_events(cache, config, now, window_start, window_end):
    """The last known good list as the fallback for a failed run. The user's
    current filters still apply to it, and occurrences that ended before the
    agenda window are gone -- a backend down for days must not keep showing
    last week's meetings."""
    events = apply_filters(previous_events(cache), config, now, window_end)
    return [event for event in events if max(event["end"], event["start"]) >= window_start]


def build_payload(backend, status, error, warning, events, refreshed_at, refresh_ok_at,
                  stale, now, restart_notice="", restart_shell_pid=0):
    """`error` belongs to status "error" alone. `warning` is the separate channel
    for "usable but degraded" -- a partial calendar failure, a rejected config
    value, a test event outside the window -- and stays "" when there is none, so
    a consumer can treat any non-empty warning as something to surface.
    `refreshed_at` is the last ATTEMPTED network refresh (the throttle),
    `refresh_ok_at` the last one that succeeded (the freshness).
    `restart_notice` repeats the text `warning` starts with when the service
    that ran this fetch is outdated, and `restart_shell_pid` names the process
    that started the run -- the desktop shell for every run of the service --
    so that a reader in another shell process, i.e. after a restart, can cut
    exactly that text again (see restart_needed)."""
    payload = {
        "schema": SCHEMA_VERSION,
        "backend": backend,
        "status": status,
        "error": error,
        "warning": warning,
        "generated_at": int(now),
        "refreshed_at": int(refreshed_at or 0),
        "refresh_ok_at": int(refresh_ok_at or 0),
        "events": [{key: value for key, value in event.items() if not key.startswith("_")}
                   for event in events],
    }
    if stale:
        payload["stale"] = True
    if restart_notice:
        payload["restart_notice"] = restart_notice
        payload["restart_shell_pid"] = int(restart_shell_pid)
    return payload


def write_cache(path, payload, prefix=".events-"):
    """0600 file in a 0700 directory, swapped in with os.replace so a reader
    never sees a half-written cache. The directory lives on tmpfs on purpose.
    Also used for the inject marker, which needs the same treatment."""
    directory = os.path.dirname(path) or "."
    created = not os.path.isdir(directory)
    os.makedirs(directory, mode=0o700, exist_ok=True)
    # 0700 is enforced on the directory this script owns -- the runtime dir, or
    # one it has just created -- never on an arbitrary --out parent (or the cwd
    # for a bare file name), which used to lose its group/other bits silently.
    if created or os.path.realpath(directory) == os.path.realpath(runtime_dir()):
        try:
            os.chmod(directory, 0o700)
        except OSError:
            pass
    descriptor, tmp_path = tempfile.mkstemp(dir=directory, prefix=prefix, suffix=".tmp")
    try:
        os.fchmod(descriptor, 0o600)
        with os.fdopen(descriptor, "w", encoding="utf-8") as handle:
            json.dump(payload, handle, ensure_ascii=False)
            handle.write("\n")
            handle.flush()
            os.fsync(handle.fileno())
        os.replace(tmp_path, path)
    except BaseException:
        _unlink(tmp_path)
        raise


def _unlink(path):
    try:
        os.unlink(path)
    except OSError:
        pass


# --- injected test event (--in-seconds) -------------------------------------

INJECT_BASENAME = "inject.json"
INJECT_UID = "omeetingbar-inject"
INJECT_CALENDAR = "Test"
INJECT_URL = "https://meet.google.com/tst-test-tst"
INJECT_DURATION_SECONDS = 1800


def inject_path_for(out_path):
    """The marker sits next to the cache, so --out moves both together."""
    return os.path.join(os.path.dirname(out_path) or ".", INJECT_BASENAME)


def write_inject(path, now, in_seconds):
    """Arm the test event. Three properties are load-bearing, because this is the
    only way to test the real alert path end to end:

    * `--in-seconds N` means exactly N seconds -- start is now + N, no grid
      snapping, so the alert lands at N - alert_lead_seconds;
    * the arming is PERSISTED. Service.qml re-runs this script with no arguments
      every fetch_interval_seconds, and such a run rewrites the cache; an event
      that existed only in one run's output was gone within a minute and could
      never fire. Every later run merges this marker back in instead.
    * the id is written once and read back unchanged, so it stays stable across
      runs without being recomputed from the clock (a moving id re-fires the
      alert on every fetch).

    A second --in-seconds simply replaces the file, so re-arming with a different
    lead works.
    """
    start = int(now) + int(in_seconds)
    write_cache(path, {
        "id": event_id(INJECT_UID, start),
        "title": _("injectTitle"),
        "start": start,
        "end": start + INJECT_DURATION_SECONDS,
        "url": INJECT_URL,
    }, prefix=".inject-")


def load_inject(path, now, grace):
    """-> the armed test event, or None. The marker is deleted once its start is
    older than the grace window: Service.qml cannot alert on it anymore, so it
    is spent and must not resurface in a later session. `end` is taken from the
    file as written -- no consumer invents a duration."""
    marker = load_cache(path)  # same tolerant JSON reader as the cache
    start = _int(marker.get("start"), None)
    if start is None:
        _unlink(path)  # absent or unusable -- either way there is nothing to inject
        return None
    if now - start > max(grace, 0):
        _unlink(path)
        return None
    event = make_event(INJECT_UID, str(marker.get("title") or _("injectTitle")), start,
                       _int(marker.get("end"), start), False,
                       clean_url(str(marker.get("url") or "")), INJECT_CALENDAR,
                       _("injectLocation"), "inject")
    if isinstance(marker.get("id"), str) and marker["id"]:
        event["id"] = marker["id"]
    return event


def merge_inject(events, injected, config, now, window_end):
    """-> (events, warning). Merged on EVERY run and on every code path, the
    error one included: on a machine without EDS a plain run ends in the
    BackendError branch, and the test alert has to survive that too. A stale
    cache can already carry the previous run's copy, hence the de-dup by id.

    Only the window applies to the marker: a title_blocklist entry such as
    "test" or a min_duration_minutes above its length must not make the test
    vanish behind a warning that blames the window. The grace side is
    load_inject's -- an expired marker never gets here. `config` and `now` stay
    in the signature for the callers' sake."""
    events = [event for event in events if event["id"] != injected["id"]]
    if injected["start"] >= window_end:
        return events, _("injectOutsideWindow")
    return sorted(events + [injected], key=lambda event: (event["start"], event["id"])), ""


# --- backend: demo ----------------------------------------------------------

DEMO_CALENDAR = "Demo"

# days from today, (hour, minute), minutes, title key, link text, location key,
# all-day. Titles and locations are MESSAGES keys so the demo speaks the UI
# language; the link is handed to pick_join_url as if it were the invite body,
# so the demo exercises the same extraction path the real backends use.
DEMO_SCHEDULE = (
    (0, (9, 30), 15, "demoStandup", "Join: https://meet.google.com/aaa-bbbb-ccc", "", False),
    (0, (14, 0), 60, "demoSprintReview", "Video: https://meet.google.com/ddd-eeee-fff", "", False),
    (0, (11, 0), 30, "demoPartner", "https://teams.microsoft.com/l/meetup-join/demo", "", False),
    (0, (16, 30), 30, "demoOneOnOne", "", "demoRoom", False),
    (0, (0, 0), 1440, "demoVacation", "", "", True),
    (1, (11, 0), 45, "demoCustomer", "https://example.zoom.us/j/1234567890", "", False),
    (1, (15, 0), 30, "demoCommunity", "Room: https://meet.jit.si/omeetingbar-demo", "", False),
)


def _local_epoch(day, hour, minute):
    """Local wall clock -> unix seconds. Naive datetime.timestamp() resolves
    through the system zone, which is exactly what "09:30 on that day" means."""
    return int(datetime.datetime(day.year, day.month, day.day, hour, minute).timestamp())


def demo_events(now):
    """The synthetic schedule only. The --in-seconds test event is not a demo
    event any longer: it is a marker file that every backend merges in."""
    events = []
    today = datetime.date.fromtimestamp(now)
    for offset, (hour, minute), minutes, title_key, link, location_key, all_day in DEMO_SCHEDULE:
        day = today + datetime.timedelta(days=offset)
        start = _local_epoch(day, hour, minute)
        location = _(location_key) if location_key else ""
        url, path = pick_join_url("", "", location, link)
        # The uid is date-free and language-free (built from the key, not the
        # title): the start already varies per day, and the id mixes both, so
        # ids stay stable within a day, differ across days, and survive a
        # language switch.
        uid = "omeetingbar-demo-%s" % re.sub(r"[^a-z0-9]+", "-", title_key.lower()).strip("-")
        events.append(make_event(uid, _(title_key), start, start + minutes * 60, all_day,
                                 url, DEMO_CALENDAR, location, path))
    return events


# --- backend: ics (backstop) ------------------------------------------------


class HttpsOnlyRedirectHandler(urllib.request.HTTPRedirectHandler):
    """Refuse to follow a redirect that leaves https -- the feed URL is a bearer
    token and must never be replayed over plaintext."""

    def redirect_request(self, req, fp, code, msg, headers, newurl):
        if newurl[:8].lower() != "https://":
            return None
        return super().redirect_request(req, fp, code, msg, headers, newurl)


def _network_detail(exc):
    """A short, URL-free description of a fetch failure. urllib puts the URL on
    HTTPError.url and sometimes into str(); only the status/errno is quoted."""
    if isinstance(exc, urllib.error.HTTPError):
        return "HTTP %s" % exc.code
    if isinstance(exc, urllib.error.URLError):
        reason = getattr(exc, "reason", None)
        detail = getattr(reason, "strerror", None) or type(reason).__name__
        return _("networkError", _short(detail, 60))
    return type(exc).__name__


def _http_get_ics(url, timeout=ICS_TIMEOUT_SECONDS):
    request = urllib.request.Request(url, headers={"User-Agent": "omeetingbar/1"})
    opener = urllib.request.build_opener(HttpsOnlyRedirectHandler)
    with opener.open(request, timeout=timeout) as response:
        payload = response.read(MAX_ICS_BYTES + 1)
    if len(payload) > MAX_ICS_BYTES:
        raise ValueError("feed larger than %d bytes" % MAX_ICS_BYTES)
    return payload.decode("utf-8", "replace")


def _ics_property(component, key):
    value = component.get(key)
    if isinstance(value, list):
        value = value[0] if value else None
    return value


def _ics_text(component, key):
    value = _ics_property(component, key)
    return "" if value is None else str(value)


def _dt_to_epoch(value):
    """datetime/date -> unix seconds.

    Order matters: datetime is a subclass of date. An aware datetime carries its
    own offset; a naive one is floating local time; a bare date is an all-day
    entry and resolves to LOCAL midnight, because "all day on the 11th" means
    midnight where the user is, not midnight UTC.
    """
    if isinstance(value, datetime.datetime):
        return int(value.timestamp())
    if isinstance(value, datetime.date):
        return int(datetime.datetime(value.year, value.month, value.day).timestamp())
    return None


def ics_component_to_event(component, calendar_name):
    """Pure: takes an already-parsed component, returns a cache entry or None."""
    # A cancelled occurrence the feed still lists must not blank the screen.
    if _ics_text(component, "STATUS").strip().upper() == "CANCELLED":
        return None
    start_value = getattr(_ics_property(component, "DTSTART"), "dt", None)
    start = _dt_to_epoch(start_value)
    if start is None:
        return None
    end_value = getattr(_ics_property(component, "DTEND"), "dt", None)
    end = _dt_to_epoch(end_value)
    if end is None:
        # RFC 5545 allows DURATION instead of DTEND; a feed that uses it would
        # otherwise produce zero-length occurrences that every surface treats
        # as over the second they start.
        duration = getattr(_ics_property(component, "DURATION"), "dt", None)
        if isinstance(duration, datetime.timedelta):
            end = start + int(duration.total_seconds())
    all_day = isinstance(start_value, datetime.date) and not isinstance(start_value, datetime.datetime)
    location = _ics_text(component, "LOCATION")
    url, path = pick_join_url(_ics_text(component, "CONFERENCE"),
                              _ics_text(component, "X-GOOGLE-CONFERENCE"),
                              location, _ics_text(component, "DESCRIPTION"))
    return make_event(_ics_text(component, "UID"), _ics_text(component, "SUMMARY"),
                      start, end, all_day, url, calendar_name, location, path)


def read_ics(config, window_start, window_end):
    """-> (events, failure). Raises BackendError when nothing could be read; a
    non-empty `failure` means some feeds were unreadable (D2: with nothing left
    after filtering the caller turns that into status "error").
    Feed URLs are secrets: failures are reported by list position only."""
    urls = [url.strip() for url in config["ics_urls"] if isinstance(url, str) and url.strip()]
    if not urls:
        raise BackendError(_("icsNoUrls"))
    try:
        import icalendar
        import recurring_ical_events
    except ImportError as exc:
        raise BackendError(_("icsPackagesMissing", getattr(exc, "name", None) or "icalendar",
                             ICS_PACKAGES)) from None

    utc = datetime.timezone.utc
    from_time = datetime.datetime.fromtimestamp(window_start, tz=utc)
    to_time = datetime.datetime.fromtimestamp(window_end, tz=utc)

    events = []
    failures = []
    # ICS_TIMEOUT_SECONDS is per socket operation, so a slow-drip server or
    # three feeds could outlast the service's 45 s watchdog; one monotonic
    # deadline across all sources keeps the whole run inside it.
    deadline = time.monotonic() + ICS_BUDGET_SECONDS
    for index, url in enumerate(urls, start=1):
        if url[:8].lower() != "https://":
            failures.append(_("srcHttpsOnly", index))
            continue
        remaining = deadline - time.monotonic()
        if remaining < 1:
            failures.append(_("srcBudget", index))
            continue
        try:
            text = _http_get_ics(url, min(ICS_TIMEOUT_SECONDS, remaining))
        except Exception as exc:
            failures.append(_("srcDetail", index, _network_detail(exc)))
            continue
        try:
            calendar = icalendar.Calendar.from_ical(text)
            name = _ics_text(calendar, "X-WR-CALNAME") or "ICS %d" % index
            occurrences = recurring_ical_events.of(calendar).between(from_time, to_time)
        except Exception as exc:
            failures.append(_("srcUnparseable", index, type(exc).__name__))
            continue
        broken = 0
        for count, component in enumerate(occurrences, start=1):
            if count > MAX_INSTANCES_PER_CALENDAR:
                failures.append(_("srcCapped", index, MAX_INSTANCES_PER_CALENDAR))
                break
            # One malformed component must not take the rest of its feed down.
            try:
                event = ics_component_to_event(component, name)
            except Exception:
                broken += 1
                continue
            if event is not None:
                events.append(event)
        if broken:
            failures.append(_("srcBroken", index, broken))

    if failures and not events:
        raise BackendError(_("icsNoneReadable", "; ".join(failures)))
    return events, _("icsProblems", "; ".join(failures)) if failures else ""


# --- backend: eds (default) -------------------------------------------------


def import_eds():
    """-> (EDataServer, ECal, ICalGLib, GLib), or BackendError naming the package
    to install. Every gi call is guarded: on a machine without
    evolution-data-server none of these typelibs exist, and the plugin has to
    show one useful sentence instead of a traceback."""
    try:
        import gi
    except ImportError:
        raise BackendError(_("giMissing")) from None

    missing = []
    for namespace, versions in EDS_NAMESPACES:
        for version in versions:
            try:
                gi.require_version(namespace, version)
                break
            except (ValueError, AttributeError):
                continue
        else:
            missing.append(namespace)
    if missing:
        packages = sorted({typelib_package(namespace) for namespace in missing})
        raise BackendError(_("typelibsMissing",
                             ", ".join(_("typelibName", namespace) for namespace in missing),
                             ", ".join(packages), GOA_DIALOG, EDS_PACKAGES))

    try:
        from gi.repository import ECal, EDataServer, Gio, GLib, ICalGLib
    except (ImportError, ValueError) as exc:
        raise BackendError(_("edsUnusable", _short(exc, 80), EDS_PACKAGES)) from None
    return EDataServer, ECal, ICalGLib, GLib, Gio


def ical_time_to_epoch(value, ical):
    """ICalGLib.Time -> unix seconds (UTC). Three traps live in here.

    1. as_timet() does NOT apply the timezone the time carries -- it reads the
       wall-clock digits as if they were already UTC. A 14:00 Europe/Berlin
       meeting therefore comes back as 14:00Z, two hours early in summer.
       convert_to_zone(UTC) rewrites the digits to real UTC first, and only then
       is as_timet() correct.
    2. A time with no zone that is not marked UTC is floating local time. There
       is nothing to convert it to, so its digits are resolved through the system
       zone instead -- as_timet() would again read them as UTC.
    3. An all-day event is a pure date (is_date() -> True). The user means
       "midnight where I am", so it resolves through the local zone as well.
    """
    if value is None or _call(value, "is_null_time", False):
        return None
    year = _call(value, "get_year", 0)
    month = _call(value, "get_month", 0)
    day = _call(value, "get_day", 0)
    if not (year and month and day):
        return None

    if _call(value, "is_date", False):
        return int(datetime.datetime(year, month, day).timestamp())

    if not _call(value, "is_utc", False):
        if _call(value, "get_timezone") is not None:
            value = value.convert_to_zone(ical.Timezone.get_utc_timezone())
        else:
            return int(datetime.datetime(year, month, day,
                                         _call(value, "get_hour", 0),
                                         _call(value, "get_minute", 0),
                                         _call(value, "get_second", 0)).timestamp())
    return int(value.as_timet())


def _property_text(icomp, ical, kind_name):
    """First value of a property kind, as a string. The kind may not exist in the
    installed libical (CONFERENCE arrived in 3.0), hence the getattr guard."""
    kind = getattr(ical.PropertyKind, kind_name, None)
    if kind is None:
        return ""
    try:
        prop = icomp.get_first_property(kind)
    except Exception:
        return ""
    return _property_value(prop) if prop is not None else ""


def _property_value(prop):
    for getter in ("get_value_as_string", "get_conference", "get_x", "get_url"):
        value = _call(prop, getter)
        if value:
            return str(value).strip()
    return ""


def _x_property_text(icomp, ical, x_name):
    """Value of a named X-property. libical exposes these as one X_PROPERTY kind
    whose name has to be compared by hand."""
    kind = getattr(ical.PropertyKind, "X_PROPERTY", None)
    if kind is None:
        return ""
    try:
        prop = icomp.get_first_property(kind)
        while prop is not None:
            if (_call(prop, "get_x_name") or "").upper() == x_name:
                value = _property_value(prop)
                if value:
                    return value
            prop = icomp.get_next_property(kind)
    except Exception:
        return ""
    return ""


def component_texts(icomp, ical):
    """Every string the pure helpers need, pulled out in one place so the URL
    precedence and the time maths stay free of gi."""
    return {
        "uid": _call(icomp, "get_uid") or "",
        "title": _call(icomp, "get_summary") or "",
        "location": _call(icomp, "get_location") or "",
        "description": _call(icomp, "get_description") or "",
        "conference": _property_text(icomp, ical, "CONFERENCE_PROPERTY"),
        "x_google_conference": _x_property_text(icomp, ical, "X-GOOGLE-CONFERENCE"),
    }


def attendee_partstat(icomp, ical, identities):
    """PARTSTAT of the account's own ATTENDEE line, upper-cased, or "" when the
    user is not listed. Identities never leave this process."""
    kind = getattr(ical.PropertyKind, "ATTENDEE_PROPERTY", None)
    if kind is None:
        return ""
    try:
        prop = icomp.get_first_property(kind)
        while prop is not None:
            email = _strip_mailto(_call(prop, "get_attendee") or "")
            if email.lower() in identities:
                try:
                    status = prop.get_parameter_as_string("PARTSTAT")
                except Exception:
                    status = ""
                return (status or "").upper()
            prop = icomp.get_next_property(kind)
    except Exception:
        return ""
    return ""


def instance_to_event(icomp, instance_start, instance_end, ical, calendar_name, identities):
    """`icomp` is the series' component for THIS occurrence: its own
    get_dtstart() still reads the recurrence master's original date (a
    birthday's 1988, not this year's), which is why only the instance times the
    callback handed over are used."""
    start = ical_time_to_epoch(instance_start, ical)
    if start is None:
        return None
    # A cancelled occurrence that the backend still hands over must not blank
    # the screen. Only the exact status counts; a missing getter reads as "not
    # cancelled", since a lost meeting is worse than a cancelled one listed.
    cancelled = getattr(ical.PropertyStatus, "CANCELLED", None)
    if cancelled is not None and _call(icomp, "get_status") == cancelled:
        return None
    texts = component_texts(icomp, ical)
    url, path = pick_join_url(texts["conference"], texts["x_google_conference"],
                              texts["location"], texts["description"])
    # A decline is a FLAG, not a drop (invariant 5): the agenda strikes such a
    # meeting through, and skip_declined only decides on the alert side whether
    # it may blank the screen. Only the exact string DECLINED counts --
    # attendee_partstat returns "" both for "the user is not in the attendee
    # list" and for "no PARTSTAT recorded", and neither of those is a decline.
    declined = bool(identities) and attendee_partstat(icomp, ical, identities) == "DECLINED"
    return make_event(texts["uid"], texts["title"], start,
                      ical_time_to_epoch(instance_end, ical),
                      bool(_call(instance_start, "is_date", False)),
                      url, calendar_name, texts["location"], path, declined=declined)


def generate_instances(client, ical, glib, window_start, window_end, calendar_name, identities):
    """-> (events, problem, capped). generate_instances_sync is what actually
    expands recurrences; get_object_list_as_comps_sync hands back the masters
    instead. `capped` means the calendar hit MAX_INSTANCES_PER_CALENDAR and the
    expansion was stopped -- a runaway rule, not a failure."""
    collected = []
    trouble = []
    capped = []

    def on_instance(icomp, instance_start, instance_end, *_rest):
        # ECalRecurInstanceCb also passes user_data and a GCancellable; *_rest
        # absorbs whichever arity the installed binding uses. An exception here
        # would unwind through C, so nothing may escape. Returning False stops
        # the expansion.
        if len(collected) >= MAX_INSTANCES_PER_CALENDAR:
            capped.append(True)
            return False
        try:
            event = instance_to_event(icomp, instance_start, instance_end, ical,
                                      calendar_name, identities)
            if event is not None:
                collected.append(event)
        except Exception as exc:
            trouble.append("%s: %s" % (type(exc).__name__, _scrub(_short(exc, 60))))
        return True

    start, end = int(window_start), int(window_end)
    try:
        try:
            client.generate_instances_sync(start, end, None, on_instance)
        except TypeError:
            client.generate_instances_sync(start, end, None, on_instance, None)
    except glib.Error as exc:
        return collected, _scrub(_short(getattr(exc, "message", exc), 80)), bool(capped)
    except Exception as exc:
        return collected, type(exc).__name__, bool(capped)
    return collected, (trouble[0] if trouble else ""), bool(capped)


def google_collection_roots(registry):
    """Top-level sources that stand for a linked Google account. The GOA
    extension is deliberately not required: a Collection root with backend
    "google" is the account whether GOA created it or the user did by hand."""
    roots = []
    for source in registry.list_sources(None):
        if source.get_parent():
            continue
        if not source.has_extension("Collection"):
            continue
        if source.get_extension("Collection").get_backend_name() != "google":
            continue
        roots.append(source)
    return roots


def calendar_sources(registry, roots):
    """Direct Calendar children of those roots, enabled per
    registry.check_enabled() -- source.get_enabled() alone still reports True
    for a calendar whose parent account is switched off."""
    root_uids = {source.get_uid() for source in roots}
    found = []
    for source in registry.list_sources(None):
        if source.get_parent() not in root_uids:
            continue
        if not source.has_extension("Calendar"):
            continue
        if not registry.check_enabled(source):
            continue
        found.append(source)
    return found


def calendar_excluded(source, excluded):
    """calendars_exclude matches either the display name or the UID. The
    exclusion set is lower-cased, so the raw uid has to be lower-cased too --
    comparing it as-is made every uid entry a no-op unless it happened to be
    all lower case already."""
    if not excluded:
        return False
    name = (source.get_display_name() or "").strip().lower()
    uid = (source.get_uid() or "").strip().lower()
    return name in excluded or uid in excluded


def account_identities(roots):
    """Lower-cased addresses this machine's own account owns, for skip_declined.
    Held in memory only and never written anywhere."""
    identities = set()
    for source in roots:
        for extension_name, getter in (("Collection", "get_identity"),
                                       ("Authentication", "get_user")):
            if not source.has_extension(extension_name):
                continue
            value = _strip_mailto(_call(source.get_extension(extension_name), getter) or "")
            if value:
                identities.add(value.lower())
    return identities


def open_registry(eds, glib):
    try:
        return eds.SourceRegistry.new_sync(None)
    except glib.Error as exc:
        raise BackendError(_("registryDown", _short(getattr(exc, "message", exc), 80))) from None


def read_eds(config, now, window_start, window_end, cache, cache_path, force_refresh):
    """-> (events, refreshed_at, failure, warnings, refresh_ok_at). Raises
    BackendError when there is no usable calendar at all. A single failing
    calendar only fills `failure`, which the caller reports as a warning -- or,
    when nothing survives filtering, as status "error" (D2) -- and keeps its
    events from the previous cache. `cache_path` is where the refresh stamp is
    persisted ahead of the refresh; None (diagnose) writes nothing."""
    eds, ecal, ical, glib, gio = import_eds()
    registry = open_registry(eds, glib)

    # These two strings are what the widget and `omeetingbar status` put in front of
    # the user in exactly the situation where the next step matters, so they name
    # the GOA dialog that is actually installable here (GOA_DIALOG) and nothing
    # else.
    roots = google_collection_roots(registry)
    if not roots:
        raise BackendError(_("noGoogleAccount", GOA_DIALOG))
    sources = calendar_sources(registry, roots)
    if not sources:
        raise BackendError(_("noEnabledCalendar", GOA_DIALOG))

    warnings = []
    # Resolved regardless of skip_declined: the identities feed the `declined`
    # flag, which is calendar data the popup renders either way, and no longer a
    # filter over the cache. The warning below stays tied to skip_declined,
    # because that is the option a missing own address renders ineffective.
    identities = account_identities(roots)
    if config["skip_declined"] and not identities:
        # Without an own address there is nothing to compare ATTENDEE against, so
        # the filter silently does nothing and declined meetings still raise a
        # fullscreen alert. That has to be visible, not silent.
        warnings.append(_("skipDeclinedNoIdentity"))
    excluded = {name.strip().lower() for name in config["calendars_exclude"] if name.strip()}

    # EDS's own refresh interval defaults to 60 minutes, which is far too coarse
    # for a meeting alarm, so a network refresh is pushed by hand -- but only
    # every refresh_seconds, since the fetcher itself runs every minute.
    refreshed_at = _int(cache.get("refreshed_at"))
    refresh_ok_at = _int(cache.get("refresh_ok_at"))
    refresh_due = force_refresh or (now - refreshed_at) >= max(config["refresh_seconds"], 0)
    if refresh_due:
        # Stamp the ATTEMPT, not the success, and persist it BEFORE refreshing:
        # a refresh that hangs into the service's watchdog is killed before this
        # run writes its cache, and without the stamp the next run would hang
        # again, for ever, while the local copy stayed perfectly readable.
        refreshed_at = now
        if cache and cache_path:
            try:
                write_cache(cache_path, dict(cache, refreshed_at=now))
            except (OSError, ValueError):
                pass

    events = []
    failures = []
    failed_names = set()
    refresh_tried = 0
    refresh_failed = 0
    deadline = time.monotonic() + REFRESH_BUDGET_SECONDS
    for index, source in enumerate(sources, start=1):
        name = _short(source.get_display_name() or "", 120)
        if calendar_excluded(source, excluded):
            continue
        # Calendars are named by position in anything user-facing: display
        # names are often an address or a colleague's name, and these strings
        # reach the widget tooltip and `omeetingbar status`.
        label = _("calendarLabel", index)
        try:
            client = ecal.Client.connect_sync(source, ecal.ClientSourceType.EVENTS,
                                              CONNECT_TIMEOUT_SECONDS, None)
        except glib.Error as exc:
            failures.append("%s (%s)" % (label, _scrub(_short(getattr(exc, "message", exc), 60))))
            failed_names.add(name)
            continue
        except Exception as exc:
            # Anything else from one calendar is that calendar's problem, not
            # the run's: it used to abort everything via main()'s last resort.
            failures.append("%s (%s)" % (label, type(exc).__name__))
            failed_names.add(name)
            continue

        if refresh_due:
            try:
                if client.check_refresh_supported():
                    refresh_tried += 1
                    remaining = deadline - time.monotonic()
                    if remaining <= 0:
                        raise TimeoutError("refresh budget spent")
                    # A cancellable fired from a timer is the only deadline
                    # refresh_sync offers; an unreachable backend (VPN down,
                    # captive portal) otherwise blocks until the watchdog.
                    cancellable = gio.Cancellable()
                    timer = threading.Timer(remaining, cancellable.cancel)
                    timer.daemon = True
                    timer.start()
                    try:
                        client.refresh_sync(cancellable)
                    finally:
                        timer.cancel()
            except Exception:
                # The locally cached copy stays readable; the failure is counted
                # and surfaced below instead of being swallowed.
                refresh_failed += 1

        collected, problem, capped = generate_instances(client, ical, glib, window_start,
                                                        window_end, name, identities)
        events.extend(collected)
        if problem:
            failures.append("%s (%s)" % (label, problem))
            failed_names.add(name)
        if capped:
            warnings.append(_("calCapped", label, MAX_INSTANCES_PER_CALENDAR))

    # A refresh that keeps failing (revoked token, VPN down) used to be
    # invisible: EDS served its old local copy as `status: "ok"` with a fresh
    # refreshed_at, and meetings added or moved since never reached the cache.
    if refresh_due:
        if refresh_tried == 0 or refresh_failed == 0:
            refresh_ok_at = now  # nothing to refresh, or all of it worked
        elif refresh_failed == refresh_tried:
            warnings.append(_("syncFailed"))
        else:
            refresh_ok_at = now
            warnings.append(_("syncPartial", refresh_failed, refresh_tried))
    if refresh_ok_at and now - refresh_ok_at > REFRESH_STALE_SECONDS:
        warnings.append(_("syncStale", human_delta(now - refresh_ok_at)))

    if failed_names:
        # A calendar that failed this run keeps its last known events instead of
        # vanishing for a minute: Service.qml withdraws a queued alert whose
        # event is gone from a healthy cache, and the agenda would lose its rows.
        known = {event["id"] for event in events}
        carried = 0
        for event in previous_events(cache):
            if event["calendar"] in failed_names and event["id"] not in known:
                event["_join_path"] = "cache"
                events.append(event)
                carried += 1
        if carried:
            failures.append(_("carried", carried))

    if failures and not events:
        raise BackendError(_("calendarsUnreadable", "; ".join(failures)))
    failure = _("partialFailure", "; ".join(failures)) if failures else ""
    return events, refreshed_at, failure, warnings, refresh_ok_at


# --- fetch dispatch ---------------------------------------------------------


def fetch(config, backend, args, now, window_start, window_end, cache, cache_path=None):
    """-> (events, refreshed_at, failure, warnings, refresh_ok_at). Raises
    BackendError when the backend produced nothing trustworthy at all. `failure`
    non-empty means the backend delivered only part of its data; `warnings` are
    non-fatal notes. `cache_path` None means "write nothing" (diagnose)."""
    if backend == "demo":
        return demo_events(now), now, "", [], now
    if backend == "ics":
        events, failure = read_ics(config, window_start, window_end)
        return events, now, failure, [], now
    return read_eds(config, now, window_start, window_end, cache, cache_path, args.refresh)


def window_for(config, now):
    """-> (start, end) for the agenda: [local midnight today, local midnight the
    day after tomorrow), so the popup can show today from 00:00 and all of
    tomorrow. The end is EXCLUSIVE (see apply_filters).

    The boundaries are computed with datetime.date arithmetic plus a naive
    .timestamp() (the _local_epoch idiom), never as `midnight + N * 86400`:
    Europe/Berlin has a 25 h day (2026-10-25) and a 23 h day (2026-03-29), and
    the arithmetic form was measured to put the end an hour off on both -- one
    hour of tomorrow's late meetings lost in one direction, a day-after-tomorrow
    meeting leaking into the "Morgen" section in the other.

    lookahead_minutes and grace_seconds can only ever EXTEND this window, never
    shorten it: the alert horizon must not shrink below the agenda just because
    someone configured a small lookahead.
    """
    today = datetime.date.fromtimestamp(now)
    start = _local_epoch(today, 0, 0)
    end = _local_epoch(today + datetime.timedelta(days=2), 0, 0)
    # max(0, ...) is not cosmetic: a grace_seconds larger than the current epoch
    # drives the lower bound negative, and libecal then ABORTS the query on an
    # assertion instead of raising — generate_instances gets 0 instances with an
    # empty error string, so the run would write a cheerful `status: "ok"` with
    # an empty agenda and no alerts at all.
    return (max(0, min(start, now - max(config["grace_seconds"], 0))),
            max(end, now + config["lookahead_minutes"] * 60))


# --- update check -----------------------------------------------------------

# "omarchy plugin update" replaces the files, but the running service keeps its
# old code until "omarchy restart shell", and nothing used to tell the user. The
# service names its own version in this variable; the installed one is the
# manifest in the plugin directory this script lives in.
SERVICE_VERSION_ENV = "OMEETINGBAR_SERVICE"
MANIFEST_PATH = os.path.join(os.path.dirname(os.path.dirname(os.path.realpath(__file__))),
                             "manifest.json")
# /proc/<pid>/comm of the desktop shell: Quickshell's binary and its short alias.
SHELL_PROCESS_NAMES = ("quickshell", "qs")


def installed_version():
    """The plugin version on disk, "" when the manifest cannot be read."""
    version = load_cache(MANIFEST_PATH).get("version")  # same tolerant JSON reader
    return version.strip() if isinstance(version, str) else ""


def parent_process_name():
    try:
        with open("/proc/%d/comm" % os.getppid(), "r", encoding="utf-8") as handle:
            return handle.read().strip()
    except (OSError, ValueError):
        return ""


def restart_needed(environ):
    """True when the service that ran this fetch is older than the installed
    plugin. A service from before the variable existed passes none; it is
    recognised by the desktop shell being the parent, because a run from a
    terminal has no service behind it and must not warn. Without a readable
    manifest there is nothing to compare, so nothing is said."""
    installed = installed_version()
    if not installed:
        return False
    running = environ.get(SERVICE_VERSION_ENV)
    if running is None:
        return parent_process_name() in SHELL_PROCESS_NAMES
    return running.strip() != installed


# --- diagnose ---------------------------------------------------------------


def typelib_search_paths():
    paths = [p for p in (os.environ.get("GI_TYPELIB_PATH") or "").split(os.pathsep) if p]
    paths += ["/usr/lib/girepository-1.0", "/usr/lib64/girepository-1.0",
              "/usr/local/lib/girepository-1.0"]
    return [p for p in paths if os.path.isdir(p)]


def typelib_state(namespace, versions):
    """-> (ok, detail). Importability is authoritative; the file check is what
    tells the two failures apart -- not installed at all, versus installed but
    unloadable, which needs a completely different fix."""
    try:
        import gi
    except ImportError:
        return False, _("gobjectMissing")
    for version in versions:
        try:
            gi.require_version(namespace, version)
            return True, "%s-%s" % (namespace, version)
        except (ValueError, AttributeError):
            continue
    # versions[0] is the version this machine is expected to have (ICalGLib 4.0
    # from libical); the rest are only fallbacks and are named as such.
    wanted = "%s-%s.typelib" % (namespace, versions[0])
    also = _("alsoChecked", ", ".join(versions[1:])) if len(versions) > 1 else ""
    on_disk = any(os.path.exists(os.path.join(path, "%s-%s.typelib" % (namespace, version)))
                  for path in typelib_search_paths() for version in versions)
    if on_disk:
        return False, _("presentNotLoadable", wanted, also)
    return False, _("fileMissing", wanted, also)


def module_state(name):
    try:
        module = __import__(name)
    except ImportError:
        return False, _("notInstalled")
    return True, str(getattr(module, "__version__", "") or _("present"))


def goa_google_accounts():
    """-> (google count, detail). Reads GOA's own config file, so this works
    without the Goa typelib. Only counts are reported, never addresses."""
    if not os.path.exists(GOA_ACCOUNTS_PATH):
        return 0, _("goaFileMissing", GOA_ACCOUNTS_PATH)
    parser = configparser.ConfigParser(interpolation=None)
    try:
        parser.read(GOA_ACCOUNTS_PATH, encoding="utf-8")
    except (configparser.Error, OSError, UnicodeDecodeError) as exc:
        return 0, _("goaUnreadable", type(exc).__name__)
    total = google = 0
    for section in parser.sections():
        if not section.startswith("Account"):
            continue
        total += 1
        if (parser.get(section, "Provider", fallback="") or "").strip().lower() == "google":
            google += 1
    return google, _("goaTotal", total)


def diagnose_calendars(config):
    try:
        eds, _ecal, _ical, glib, _gio = import_eds()
        registry = open_registry(eds, glib)
    except BackendError as exc:
        return [_("calNotCheckable", exc.message)]
    try:
        roots = google_collection_roots(registry)
        sources = calendar_sources(registry, roots)
    except Exception as exc:
        return [_("calQueryFailed", _short(exc, 80))]
    excluded = {name.strip().lower() for name in config["calendars_exclude"] if name.strip()}
    skipped = sum(1 for source in sources if calendar_excluded(source, excluded))
    return [
        _("calAccounts", len(roots)),
        _("calEnabled", len(sources)),
        _("calExcluded", skipped),
        _("calIdentities", len(account_identities(roots))),
    ]


def diagnose_cache(path, cache, now):
    lines = [_("cacheFile", path)]
    try:
        info = os.stat(path)
    except OSError:
        lines.append(_("cacheAbsent"))
        return lines
    try:
        dir_mode = os.stat(os.path.dirname(path) or ".").st_mode & 0o777
    except OSError:
        dir_mode = 0
    lines.append(_("cacheMode", info.st_mode & 0o777, dir_mode))
    lines.append(_("cacheAge", human_delta(now - int(info.st_mtime))))
    if not cache:
        lines.append(_("cacheContent"))
        return lines
    refreshed = _int(cache.get("refreshed_at"))
    lines.append(_("cacheSchema", cache.get("schema"), cache.get("backend")))
    lines.append(_("cacheStatus", cache.get("status"), _("staleSuffix") if cache.get("stale") else ""))
    if cache.get("error"):
        lines.append(_("cacheError", _short(cache.get("error"), 200)))
    if cache.get("warning"):
        lines.append(_("cacheWarning", _short(cache.get("warning"), 200)))
    events = cache.get("events")
    lines.append(_("cacheCount", len(events) if isinstance(events, list) else 0))
    lines.append(_("cacheSync", _("ago", human_delta(now - refreshed)) if refreshed else _("never")))
    refresh_ok = _int(cache.get("refresh_ok_at"))
    lines.append(_("cacheSyncOk", _("ago", human_delta(now - refresh_ok)) if refresh_ok else _("never")))
    return lines


def diagnose_join_paths(config, backend, args, now, cache):
    """Which URL rule matched for the next few events. Path names only: no
    titles, no times, and above all never the URL itself."""
    window_start, window_end = window_for(config, now)
    try:
        events, _refreshed, failure, warnings, _ok = fetch(config, backend, args, now,
                                                           window_start, window_end, cache)
    except BackendError as exc:
        return [_("joinBackendError", exc.message)]
    except Exception as exc:
        return [_("joinUnexpected", type(exc).__name__, _short(exc, 80))]
    # Since schema 2 the agenda starts at local midnight, so without this the
    # report would describe the morning's finished meetings and never reach
    # the one being diagnosed.
    events = [event for event in apply_filters(events, config, now, window_end)
              if max(event["end"], event["start"]) > now]
    lines = [_("joinNote", note) for note in ([failure] if failure else []) + warnings]
    for index, event in enumerate(events[:MAX_DIAGNOSE_EVENTS], start=1):
        lines.append(_("joinEvent", index, event["_join_path"],
                       "" if event["url"] else _("joinNoUrl")))
    if not events:
        lines.append(_("joinNone"))
    else:
        lines.append(_("joinCount", len(events), min(len(events), MAX_DIAGNOSE_EVENTS)))
    return lines


def diagnose(args, config, config_warning, out_path, cache, now):
    stamp = datetime.datetime.fromtimestamp(now).astimezone()
    backend = args.backend or config["backend"]

    lines = [_("diagTitle"), ""]
    lines.append(_("diagEnv"))
    lines.append(_("diagTime", stamp.strftime("%Y-%m-%d %H:%M:%S"), stamp.tzname()))
    lines.append(_("diagPython", sys.version.split()[0], sys.executable))
    lines.append(_("diagVersion", installed_version() or "-",
                   os.environ.get(SERVICE_VERSION_ENV) or "-"))
    lines.append("")

    lines.append(_("diagConfig"))
    lines.append(_("diagFile", args.config, "" if os.path.exists(args.config) else _("diagMissingSuffix")))
    if config_warning:
        lines.append(_("diagProblem", config_warning))
    lines.append(_("diagBackend", backend, _("diagViaFlag") if args.backend else ""))
    lines.append(_("diagWindow", config["lookahead_minutes"], config["grace_seconds"]))
    lines.append(_("diagLead", config["alert_lead_seconds"]))
    lines.append(_("diagRefresh", config["refresh_seconds"]))
    lines.append(_("diagIcsSources", len(config["ics_urls"])))
    lines.append("")

    lines.append(_("diagPackages"))
    ok, detail = module_state("gi")
    lines.append("  %-30s %-8s gi %s" % ("python-gobject", _("diagOk") if ok else _("diagMissing"), detail))
    for namespace, versions in EDS_NAMESPACES:
        ok, detail = typelib_state(namespace, versions)
        lines.append("  %-30s %-8s %s"
                     % (typelib_package(namespace), _("diagOk") if ok else _("diagMissing"), detail))
    for module, package in (("icalendar", "python-icalendar"),
                            ("recurring_ical_events", "python-recurring-ical-events")):
        ok, detail = module_state(module)
        lines.append("  %-30s %-8s %s"
                     % (package, _("diagOk") if ok else _("diagMissing"), _("diagIcsOnly", detail)))
    lines.append(_("diagTypelibPath", ", ".join(typelib_search_paths()) or "-"))
    lines.append("")

    lines.append(_("diagGoogle"))
    google, detail = goa_google_accounts()
    lines.append(_("diagGoogleAccounts", google, detail))
    lines.append("")

    lines.append(_("diagCalendars"))
    lines.extend(diagnose_calendars(config))
    lines.append("")

    lines.append(_("diagCache"))
    lines.extend(diagnose_cache(out_path, cache, now))
    lines.append("")

    lines.append(_("diagJoin"))
    lines.extend(diagnose_join_paths(config, backend, args, now, cache))

    sys.stdout.write("\n".join(lines) + "\n")
    return 0


# --- entry point ------------------------------------------------------------


def parse_args(argv):
    parser = argparse.ArgumentParser(
        prog="omeetingbar-fetch",
        description="Write the OMeetingBar event cache.")
    parser.add_argument("--config", default=DEFAULT_CONFIG_PATH, metavar="PATH",
                        help="config file (default: %s)" % DEFAULT_CONFIG_PATH)
    parser.add_argument("--out", default=None, metavar="PATH",
                        help="cache file (default: $XDG_RUNTIME_DIR/omeetingbar/events.json, "
                             "or /run/user/<uid>/omeetingbar/events.json without "
                             "XDG_RUNTIME_DIR)")
    parser.add_argument("--backend", choices=BACKENDS, default=None,
                        help="override the configured backend")
    parser.add_argument("--in-seconds", type=int, default=None, metavar="N",
                        help="arm a test event exactly N seconds from now (any "
                             "backend): writes inject.json next to the cache, which "
                             "every later run merges in with a stable id until it "
                             "ages out of grace_seconds; re-arming replaces it")
    parser.add_argument("--refresh", action="store_true",
                        help="force a network refresh, ignoring refresh_seconds")
    parser.add_argument("--diagnose", action="store_true",
                        help="print a readiness report and exit; reads the calendar "
                             "(a due network refresh included) but writes no cache")
    parser.add_argument("--print", dest="print_json", action="store_true",
                        help="write the JSON to stdout instead of the cache file")
    return parser.parse_args(argv)


def main(argv=None):
    global LANGUAGE
    args = parse_args(argv)
    now = int(time.time())
    config, config_warning = load_config(args.config)
    LANGUAGE = pick_language(config.get("language"), os.environ)
    backend = args.backend or config["backend"]
    out_path = args.out or os.path.join(runtime_dir(), CACHE_BASENAME)
    inject_path = inject_path_for(out_path)
    cache = load_cache(out_path)

    if args.diagnose:
        return diagnose(args, config, config_warning, out_path, cache, now)

    # The restart notice goes first: the widget cuts a long warning short in
    # its tooltip, and this is the one that a single command clears.
    restart_notice = _("restartNeeded") if restart_needed(os.environ) else ""
    restart_shell_pid = os.getppid() if restart_notice else 0
    warnings = [restart_notice] if restart_notice else []
    if config_warning:
        warnings.append(config_warning)
    if args.in_seconds is not None:
        try:
            write_inject(inject_path, now, args.in_seconds)
        except OSError as exc:
            sys.stderr.write("omeetingbar-fetch: cannot write %s: %s\n"
                             % (inject_path, _short(exc, 100)))
            return 1
    injected = load_inject(inject_path, now, max(config["grace_seconds"], 0))
    if args.in_seconds is not None and injected is None:
        # write_inject armed it and load_inject spent it in the same run: the
        # start was already more than grace_seconds in the past.
        warnings.append(_("injectExpired"))

    window_start, window_end = window_for(config, now)
    status, error, failure, stale = "ok", "", "", False
    refreshed_at = now
    refresh_ok_at = _int(cache.get("refresh_ok_at"))
    try:
        events, refreshed_at, failure, backend_warnings, refresh_ok_at = fetch(
            config, backend, args, now, window_start, window_end, cache, out_path)
        warnings.extend(backend_warnings)
        events = apply_filters(events, config, now, window_end)
    except BackendError as exc:
        status, error = "error", exc.message
        events = stale_events(cache, config, now, window_start, window_end)
        stale = bool(events)
        refreshed_at = _int(cache.get("refreshed_at"))
    except Exception as exc:
        # A backend bug must still leave a readable cache behind, never a
        # traceback on the service's stderr and an unchanged stale file.
        status = "error"
        error = _("unexpectedBackendError", backend, type(exc).__name__, _scrub(_short(exc, 100)))
        events = stale_events(cache, config, now, window_start, window_end)
        stale = bool(events)
        refreshed_at = _int(cache.get("refreshed_at"))

    if len(events) > MAX_EVENTS:
        warnings.append(_("maxEvents", MAX_EVENTS))
        events = events[:MAX_EVENTS]

    if failure:
        # D2, decided AFTER filtering: a partial failure that leaves nothing
        # behind is not a usable result and must not reach the user as "no
        # meetings today" on a status-ok cache. With events left it is only a
        # warning -- the list is usable, just incomplete. The eds backend
        # carries a failed calendar's previous events forward itself, so a
        # one-minute hiccup in one calendar neither empties the agenda nor
        # withdraws a queued alert. The test marker is merged below, so arming
        # one cannot hide a half-failed calendar read.
        if events:
            warnings.append(failure)
        else:
            status, error = "error", failure

    if injected is not None:
        events, inject_warning = merge_inject(events, injected, config, now, window_end)
        if inject_warning:
            warnings.append(inject_warning)

    payload = build_payload(backend, status, error, " ".join(warnings), events,
                            refreshed_at, refresh_ok_at, stale, now, restart_notice,
                            restart_shell_pid)

    if args.print_json:
        json.dump(payload, sys.stdout, ensure_ascii=False, indent=2)
        sys.stdout.write("\n")
    else:
        try:
            write_cache(out_path, payload)
        except (OSError, ValueError) as exc:
            # ValueError covers a lone surrogate under ensure_ascii=False; the
            # message carries a position, never content.
            sys.stderr.write("omeetingbar-fetch: cannot write %s: %s\n"
                             % (out_path, _short(exc, 100)))
            return 1

    if status != "ok":
        sys.stderr.write("omeetingbar-fetch: %s\n" % error)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
